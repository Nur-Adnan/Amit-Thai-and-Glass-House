{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API server",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:staging": "NODE_ENV=staging node src/index.js",
    "start:production": "NODE_ENV=production node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:staging": "NODE_ENV=staging nodemon src/index.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "config:validate": "node -e \"require('./src/config/env.js').default.logStartup()\"",
    "deploy:staging": "./scripts/deploy-staging.sh",
    "deploy:production": "./scripts/deploy-production.sh",
    "seed:owner": "node src/scripts/createOwner.js",
    "seed:customers": "node src/scripts/seedCustomers.js",
    "seed:products": "node src/scripts/seedProducts.js",
    "seed:calculator": "node src/scripts/seedCalculatorConfig.js",
    "seed:invoices": "node src/scripts/seedInvoices.js",
    "seed:payments": "node src/scripts/seedPayments.js",
    "seed:employees": "node src/scripts/seedEmployees.js",
    "seed:expenses": "node src/scripts/seedExpenses.js",
    "seed:investments": "node src/scripts/seedInvestments.js",
    "seed:profit": "node src/scripts/seedProfitAnalyses.js",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/unit",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/integration",
    "test:profit": "node src/scripts/testProfitSystem.js",
    "test:dashboard": "node src/scripts/testDashboard.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.3",
    "@babel/preset-env": "^7.23.6",
    "babel-jest": "^29.7.0"
  },
  "type": "module"
}
