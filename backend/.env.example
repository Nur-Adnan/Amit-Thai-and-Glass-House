# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/thai_aluminum_dev
MONGODB_URI_TEST=mongodb://localhost:27017/thai_aluminum_test

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production_make_it_very_long_and_secure
JWT_EXPIRE=30d

# Application URLs
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Backup Configuration
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_FILES=50

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Email Configuration (if needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@thaiandglass.com
FROM_NAME=Thai & Aluminum

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Feature Flags
ENABLE_SCHEDULED_BACKUPS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true